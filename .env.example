# Application Environment & Origins
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# Public Firebase Configuration (Client-safe)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDummyKeyForDevelopment"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="rma-legal-sa.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="rma-legal-sa"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="rma-legal-sa.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"

# Public Cloudinary Configuration (Client-safe)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="rma-law"

# Server-Only Private Secrets (Do NOT expose to browser)
FIREBASE_PROJECT_ID="rma-legal-sa"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@rma-legal-sa.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Cloudinary Server Secrets
CLOUDINARY_API_KEY="mock_cloudinary_key"
CLOUDINARY_API_SECRET="mock_cloudinary_secret"
CLOUDINARY_UPLOAD_PRESET="rma_signed_media"

# Security & Session Secrets
SESSION_COOKIE_SECRET="session_secret_at_least_32_characters_long_for_security"
REVALIDATION_SECRET="revalidation_secret_token"

# Outbox Notification Settings
